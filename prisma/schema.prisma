generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String
  passwordHash String
  role         String   @default("OWNER")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Yarn {
  id        String        @id @default(cuid())
  name      String
  note      String?
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  variants  YarnVariant[]
}

model YarnVariant {
  id                    String                @id @default(cuid())
  yarnId                String
  yarn                  Yarn                  @relation(fields: [yarnId], references: [id])
  spec                  String
  color                 String
  unit                  String                @default("kg")
  active                Boolean               @default(true)
  createdAt             DateTime              @default(now())
  inventories           Inventory[]
  purchaseItems         PurchaseItem[]
  batches               Batch[]
  processingReturnItems ProcessingReturnItem[]
  processingFeeSettlements ProcessingFeeSettlement[]

  @@unique([yarnId, spec, color, unit])
}

model Warehouse {
  id                    String          @id @default(cuid())
  name                  String
  type                  String          @default("WAREHOUSE") // WAREHOUSE | FACTORY
  address               String?
  manager               String?
  active                Boolean         @default(true)
  stocktakeIntervalDays Int?            @default(30)
  createdAt             DateTime        @default(now())
  purchaseOrders        PurchaseOrder[]
  saleOrders            SaleOrder[]
  fromTransferOrders    TransferOrder[] @relation("FromWarehouse")
  toTransferOrders      TransferOrder[] @relation("ToWarehouse")
  fromProcessingReturns ProcessingReturn[] @relation("ProcessingReturnFactory")
  toProcessingReturns   ProcessingReturn[] @relation("ProcessingReturnWarehouse")
  inventories           Inventory[]
  stocktakes            Stocktake[]
  processingFeeSettlements ProcessingFeeSettlement[]
  processingFeePayments    ProcessingFeePayment[]
}

model Counterparty {
  id          String          @id @default(cuid())
  name        String
  type        String          @default("BOTH") // SUPPLIER | CUSTOMER | BOTH
  contact     String?
  phone       String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  purchases   PurchaseOrder[] @relation("Supplier")
  sales       SaleOrder[]     @relation("Customer")
  settlements Settlement[]
}

model Batch {
  id            String         @id @default(cuid())
  variantId     String
  variant       YarnVariant    @relation(fields: [variantId], references: [id])
  batchNo       String
  createdAt     DateTime       @default(now())
  inventories   Inventory[]
  purchaseItems PurchaseItem[]

  @@unique([variantId, batchNo])
}

model PurchaseOrder {
  id          String         @id @default(cuid())
  orderNo     String         @unique
  date        DateTime
  supplierId  String
  supplier    Counterparty   @relation("Supplier", fields: [supplierId], references: [id])
  warehouseId String
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])
  handlerName String
  note        String?
  totalAmount Decimal
  freight     Decimal        @default(0)
  createdAt   DateTime       @default(now())
  items       PurchaseItem[]
}

model PurchaseItem {
  id        String        @id @default(cuid())
  orderId   String
  order     PurchaseOrder @relation(fields: [orderId], references: [id])
  variantId String
  variant   YarnVariant   @relation(fields: [variantId], references: [id])
  batchId   String
  batch     Batch         @relation(fields: [batchId], references: [id])
  weight    Decimal
  price     Decimal
  amount    Decimal
  packages  Int?
}

model SaleOrder {
  id          String       @id @default(cuid())
  orderNo     String       @unique
  date        DateTime
  customerId  String
  customer    Counterparty @relation("Customer", fields: [customerId], references: [id])
  warehouseId String
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  handlerName String
  note        String?
  totalAmount Decimal
  freight     Decimal      @default(0)
  createdAt   DateTime     @default(now())
  items       SaleItem[]
}

model SaleItem {
  id          String    @id @default(cuid())
  orderId     String
  order       SaleOrder @relation(fields: [orderId], references: [id])
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  weight      Decimal
  price       Decimal
  amount      Decimal
  packages    Int?
  unitCost    Decimal   @default(0)
  unitFreight Decimal   @default(0)
}

model TransferOrder {
  id                 String         @id @default(cuid())
  orderNo            String         @unique
  date               DateTime
  fromWarehouseId    String
  fromWarehouse      Warehouse      @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouseId      String
  toWarehouse        Warehouse      @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  handlerName        String
  note               String?
  processingFeePerKg Decimal?
  freight            Decimal        @default(0)
  createdAt          DateTime       @default(now())
  items              TransferItem[]
}

model TransferItem {
  id          String        @id @default(cuid())
  orderId     String
  order       TransferOrder @relation(fields: [orderId], references: [id])
  inventoryId String
  inventory   Inventory     @relation(fields: [inventoryId], references: [id])
  weight      Decimal
  packages    Int?
}

model Inventory {
  id                    String                @id @default(cuid())
  warehouseId           String
  warehouse             Warehouse             @relation(fields: [warehouseId], references: [id])
  variantId             String
  variant               YarnVariant           @relation(fields: [variantId], references: [id])
  batchId               String
  batch                 Batch                 @relation(fields: [batchId], references: [id])
  weight                Decimal
  cost                  Decimal               @default(0)
  freight               Decimal               @default(0)
  processingFeeSettled  Boolean               @default(false)
  processingFeePerKg    Decimal?
  archived              Boolean               @default(false)
  updatedAt             DateTime              @updatedAt
  saleItems             SaleItem[]
  transferItems         TransferItem[]
  stocktakeItems        StocktakeItem[]
  processingReturnItems ProcessingReturnItem[]
}

model Stocktake {
  id          String          @id @default(cuid())
  orderNo     String          @unique
  date        DateTime
  warehouseId String
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  handlerName String
  note        String?
  createdAt   DateTime        @default(now())
  items       StocktakeItem[]
}

model StocktakeItem {
  id           String    @id @default(cuid())
  stocktakeId  String
  stocktake    Stocktake @relation(fields: [stocktakeId], references: [id])
  inventoryId  String
  inventory    Inventory @relation(fields: [inventoryId], references: [id])
  bookWeight   Decimal
  actualWeight Decimal
  diff         Decimal
}

model Settlement {
  id             String       @id @default(cuid())
  side           String       // PURCHASE（应付给供应商）| SALE（应收自客户）
  counterpartyId String
  counterparty   Counterparty @relation(fields: [counterpartyId], references: [id])
  amount         Decimal
  date           DateTime
  method         String?
  handlerName    String
  createdAt      DateTime     @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String
  action    String
  target    String
  detail    String?
  createdAt DateTime @default(now())
}

model ProcessingReturn {
  id                   String   @id @default(cuid())
  orderNo              String   @unique
  date                 DateTime
  factoryId            String
  factory              Warehouse @relation("ProcessingReturnFactory", fields: [factoryId], references: [id])
  warehouseId          String
  warehouse            Warehouse @relation("ProcessingReturnWarehouse", fields: [warehouseId], references: [id])
  handlerName          String
  note                 String?
  processingFeePerKg   Decimal  @default(0)
  freight              Decimal  @default(0)
  expectedSellPricePerKg Decimal?
  createdAt            DateTime @default(now())
  items                ProcessingReturnItem[]
}

model ProcessingReturnItem {
  id           String         @id @default(cuid())
  orderId      String
  order        ProcessingReturn @relation(fields: [orderId], references: [id])
  inventoryId  String
  inventory    Inventory      @relation(fields: [inventoryId], references: [id])
  weight       Decimal
  variantId    String
  variant      YarnVariant    @relation(fields: [variantId], references: [id])
  batchNo      String
  outputWeight Decimal
  packages     Int?
  newCost      Decimal        @default(0)
  newFreight   Decimal        @default(0)
}

model ProcessingFeeSettlement {
  id              String      @id @default(cuid())
  warehouseId     String
  warehouse       Warehouse   @relation(fields: [warehouseId], references: [id])
  variantId       String
  variant         YarnVariant @relation(fields: [variantId], references: [id])
  batchNo         String
  inputWeight     Decimal
  outputWeight    Decimal
  feePerKg        Decimal
  feeTotal        Decimal
  remainingWeight Decimal
  newUnitCost     Decimal
  handlerName     String
  createdAt       DateTime    @default(now())

  @@index([warehouseId, createdAt])
}

model ProcessingFeePayment {
  id          String    @id @default(cuid())
  factoryId   String
  factory     Warehouse @relation(fields: [factoryId], references: [id])
  amount      Decimal
  date        DateTime
  method      String?
  handlerName String
  createdAt   DateTime  @default(now())

  @@index([factoryId, date])
}
