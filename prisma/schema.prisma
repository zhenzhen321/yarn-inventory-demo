generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String
  passwordHash String
  role         String   @default("OWNER")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Yarn {
  id        String        @id @default(cuid())
  name      String
  note      String?
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  variants  YarnVariant[]
}

model YarnVariant {
  id                       String                    @id @default(cuid())
  yarnId                   String
  yarn                     Yarn                      @relation(fields: [yarnId], references: [id])
  spec                     String
  color                    String
  unit                     String                    @default("kg")
  active                   Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  inventories              Inventory[]
  purchaseItems            PurchaseItem[]
  batches                  Batch[]
  processingReturnItems    ProcessingReturnItem[]
  processingFeeSettlements ProcessingFeeSettlement[]
  inventoryLots            InventoryLot[]

  @@unique([yarnId, spec, color, unit])
}

model Warehouse {
  id                       String                    @id @default(cuid())
  name                     String
  type                     String                    @default("WAREHOUSE") // WAREHOUSE | FACTORY
  address                  String?
  manager                  String?
  active                   Boolean                   @default(true)
  stocktakeIntervalDays    Int?                      @default(30)
  createdAt                DateTime                  @default(now())
  purchaseOrders           PurchaseOrder[]
  saleOrders               SaleOrder[]
  fromTransferOrders       TransferOrder[]           @relation("FromWarehouse")
  toTransferOrders         TransferOrder[]           @relation("ToWarehouse")
  fromProcessingReturns    ProcessingReturn[]        @relation("ProcessingReturnFactory")
  toProcessingReturns      ProcessingReturn[]        @relation("ProcessingReturnWarehouse")
  inventories              Inventory[]
  stocktakes               Stocktake[]
  processingFeeSettlements ProcessingFeeSettlement[]
  processingFeePayments    ProcessingFeePayment[]
  processingJobs           ProcessingJob[]           @relation("ProcessingJobFactory")
}

model Counterparty {
  id          String          @id @default(cuid())
  name        String
  type        String          @default("BOTH") // SUPPLIER | CUSTOMER | BOTH
  contact     String?
  phone       String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  purchases   PurchaseOrder[] @relation("Supplier")
  sales       SaleOrder[]     @relation("Customer")
  settlements Settlement[]
}

model Batch {
  id            String         @id @default(cuid())
  variantId     String
  variant       YarnVariant    @relation(fields: [variantId], references: [id])
  batchNo       String
  createdAt     DateTime       @default(now())
  inventories   Inventory[]
  purchaseItems PurchaseItem[]
  inventoryLots InventoryLot[]

  @@unique([variantId, batchNo])
}

model PurchaseOrder {
  id          String         @id @default(cuid())
  orderNo     String         @unique
  date        DateTime
  supplierId  String
  supplier    Counterparty   @relation("Supplier", fields: [supplierId], references: [id])
  warehouseId String
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])
  handlerName String
  note        String?
  totalAmount Decimal
  freight     Decimal        @default(0)
  createdAt   DateTime       @default(now())
  reversedAt  DateTime?
  reversedBy  String?
  items       PurchaseItem[]

  @@index([reversedAt, date])
  @@index([supplierId])
}

model PurchaseItem {
  id        String        @id @default(cuid())
  orderId   String
  order     PurchaseOrder @relation(fields: [orderId], references: [id])
  variantId String
  variant   YarnVariant   @relation(fields: [variantId], references: [id])
  batchId   String
  batch     Batch         @relation(fields: [batchId], references: [id])
  weight    Decimal
  price     Decimal
  amount    Decimal
  packages  Int?
  lotId     String?       @unique
  lot       InventoryLot? @relation("PurchaseItemLot", fields: [lotId], references: [id])

  @@index([orderId])
}

model SaleOrder {
  id          String       @id @default(cuid())
  orderNo     String       @unique
  date        DateTime
  customerId  String
  customer    Counterparty @relation("Customer", fields: [customerId], references: [id])
  warehouseId String
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  handlerName String
  note        String?
  totalAmount Decimal
  freight     Decimal      @default(0)
  createdAt   DateTime     @default(now())
  reversedAt  DateTime?
  reversedBy  String?
  items       SaleItem[]

  @@index([reversedAt, date])
  @@index([customerId])
}

model SaleItem {
  id          String           @id @default(cuid())
  orderId     String
  order       SaleOrder        @relation(fields: [orderId], references: [id])
  inventoryId String
  inventory   Inventory        @relation(fields: [inventoryId], references: [id])
  weight      Decimal
  price       Decimal
  amount      Decimal
  packages    Int?
  unitCost    Decimal          @default(0)
  unitFreight Decimal          @default(0)
  allocations SaleAllocation[]

  @@index([orderId])
}

model TransferOrder {
  id                 String         @id @default(cuid())
  orderNo            String         @unique
  date               DateTime
  fromWarehouseId    String
  fromWarehouse      Warehouse      @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouseId      String
  toWarehouse        Warehouse      @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  handlerName        String
  note               String?
  processingFeePerKg Decimal?
  freight            Decimal        @default(0)
  createdAt          DateTime       @default(now())
  items              TransferItem[]
}

model TransferItem {
  id                     String        @id @default(cuid())
  orderId                String
  order                  TransferOrder @relation(fields: [orderId], references: [id])
  inventoryId            String
  inventory              Inventory     @relation(fields: [inventoryId], references: [id])
  weight                 Decimal
  packages               Int?
  destinationInventoryId String?

  @@index([orderId])
}

model Inventory {
  id                    String                 @id @default(cuid())
  warehouseId           String
  warehouse             Warehouse              @relation(fields: [warehouseId], references: [id])
  variantId             String
  variant               YarnVariant            @relation(fields: [variantId], references: [id])
  batchId               String
  batch                 Batch                  @relation(fields: [batchId], references: [id])
  lotId                 String?
  lot                   InventoryLot?          @relation(fields: [lotId], references: [id])
  weight                Decimal
  packages              Int?
  cost                  Decimal                @default(0)
  freight               Decimal                @default(0)
  processingFeeSettled  Boolean                @default(false)
  processingFeePerKg    Decimal?
  archived              Boolean                @default(false)
  version               Int                    @default(0)
  updatedAt             DateTime               @updatedAt
  saleItems             SaleItem[]
  transferItems         TransferItem[]
  stocktakeItems        StocktakeItem[]
  processingReturnItems ProcessingReturnItem[]
  saleAllocations       SaleAllocation[]
  processingInputs      ProcessingInput[]

  @@index([lotId, warehouseId, archived])
  @@index([variantId, batchId])
}

model Stocktake {
  id          String          @id @default(cuid())
  orderNo     String          @unique
  date        DateTime
  warehouseId String
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  handlerName String
  note        String?
  createdAt   DateTime        @default(now())
  items       StocktakeItem[]
}

model StocktakeItem {
  id           String    @id @default(cuid())
  stocktakeId  String
  stocktake    Stocktake @relation(fields: [stocktakeId], references: [id])
  inventoryId  String
  inventory    Inventory @relation(fields: [inventoryId], references: [id])
  bookWeight   Decimal
  actualWeight Decimal
  diff         Decimal

  @@index([stocktakeId])
}

model Settlement {
  id             String       @id @default(cuid())
  side           String // PURCHASE（应付给供应商）| SALE（应收自客户）
  counterpartyId String
  counterparty   Counterparty @relation(fields: [counterpartyId], references: [id])
  amount         Decimal
  date           DateTime
  method         String?
  handlerName    String
  createdAt      DateTime     @default(now())

  @@index([counterpartyId, date])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String
  action    String
  target    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model IdempotencyRequest {
  id          String    @id @default(cuid())
  operation   String
  key         String
  requestHash String
  resourceId  String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([operation, key])
  @@index([createdAt])
}

model ProcessingReturn {
  id                     String                 @id @default(cuid())
  orderNo                String                 @unique
  date                   DateTime
  factoryId              String
  factory                Warehouse              @relation("ProcessingReturnFactory", fields: [factoryId], references: [id])
  warehouseId            String
  warehouse              Warehouse              @relation("ProcessingReturnWarehouse", fields: [warehouseId], references: [id])
  handlerName            String
  note                   String?
  processingFeePerKg     Decimal                @default(0)
  freight                Decimal                @default(0)
  expectedSellPricePerKg Decimal?
  createdAt              DateTime               @default(now())
  items                  ProcessingReturnItem[]
}

model ProcessingReturnItem {
  id                     String           @id @default(cuid())
  orderId                String
  order                  ProcessingReturn @relation(fields: [orderId], references: [id])
  inventoryId            String
  inventory              Inventory        @relation(fields: [inventoryId], references: [id])
  weight                 Decimal
  variantId              String
  variant                YarnVariant      @relation(fields: [variantId], references: [id])
  batchNo                String
  outputWeight           Decimal
  packages               Int?
  newCost                Decimal          @default(0)
  newFreight             Decimal          @default(0)
  outputLotId            String?
  destinationInventoryId String?

  @@index([orderId])
}

model ProcessingFeeSettlement {
  id              String         @id @default(cuid())
  warehouseId     String
  warehouse       Warehouse      @relation(fields: [warehouseId], references: [id])
  variantId       String
  variant         YarnVariant    @relation(fields: [variantId], references: [id])
  batchNo         String
  inputWeight     Decimal
  outputWeight    Decimal
  feePerKg        Decimal
  feeTotal        Decimal
  remainingWeight Decimal
  newUnitCost     Decimal
  handlerName     String
  createdAt       DateTime       @default(now())
  processingJobId String?        @unique
  processingJob   ProcessingJob? @relation(fields: [processingJobId], references: [id])

  @@index([warehouseId, createdAt])
}

model ProcessingFeePayment {
  id          String    @id @default(cuid())
  factoryId   String
  factory     Warehouse @relation(fields: [factoryId], references: [id])
  amount      Decimal
  date        DateTime
  method      String?
  handlerName String
  createdAt   DateTime  @default(now())

  @@index([factoryId, date])
}

model InventoryLot {
  id                String            @id @default(cuid())
  lotNo             String            @unique
  scanCode          String            @unique
  sourceType        String            @default("PURCHASE") // PURCHASE | PROCESSING | LEGACY_AGGREGATED
  provenanceQuality String            @default("EXACT") // EXACT | LEGACY_AGGREGATED
  variantId         String
  variant           YarnVariant       @relation(fields: [variantId], references: [id])
  batchId           String
  batch             Batch             @relation(fields: [batchId], references: [id])
  initialWeight     Decimal
  initialPackages   Int?
  goodsCost         Decimal           @default(0)
  freightCost       Decimal           @default(0)
  processingCost    Decimal           @default(0)
  status            String            @default("AVAILABLE") // AVAILABLE | AWAITING_PROCESS | CONSUMED | ARCHIVED
  createdAt         DateTime          @default(now())
  purchaseItem      PurchaseItem?     @relation("PurchaseItemLot")
  processingOutput  ProcessingOutput? @relation("ProcessingOutputLot")
  inventories       Inventory[]
  movements         StockMovement[]
  saleAllocations   SaleAllocation[]
  processingInputs  ProcessingInput[]

  @@index([variantId, batchId])
  @@index([status, createdAt])
}

model StockMovement {
  id              String       @id @default(cuid())
  lotId           String
  lot             InventoryLot @relation(fields: [lotId], references: [id])
  type            String // PURCHASE_RECEIPT | TRANSFER | PROCESS_CONSUME | PROCESS_PRODUCE | SALE | STOCKTAKE | REVERSAL
  referenceType   String
  referenceId     String
  referenceItemId String?
  fromWarehouseId String?
  toWarehouseId   String?
  weight          Decimal
  packages        Int?
  goodsCost       Decimal      @default(0)
  freightCost     Decimal      @default(0)
  reversalOfId    String?
  occurredAt      DateTime
  createdAt       DateTime     @default(now())

  @@index([lotId, occurredAt])
  @@index([referenceType, referenceId])
}

model SaleAllocation {
  id          String       @id @default(cuid())
  saleItemId  String
  saleItem    SaleItem     @relation(fields: [saleItemId], references: [id])
  lotId       String
  lot         InventoryLot @relation(fields: [lotId], references: [id])
  inventoryId String?
  inventory   Inventory?   @relation(fields: [inventoryId], references: [id])
  warehouseId String
  weight      Decimal
  packages    Int?
  unitCost    Decimal
  unitFreight Decimal
  createdAt   DateTime     @default(now())

  @@index([saleItemId])
  @@index([lotId, createdAt])
}

model ProcessingJob {
  id                  String                   @id @default(cuid())
  orderNo             String                   @unique
  date                DateTime
  factoryId           String
  factory             Warehouse                @relation("ProcessingJobFactory", fields: [factoryId], references: [id])
  status              String                   @default("COMPLETED") // DRAFT | AT_FACTORY | PROCESSING | COMPLETED | CLOSED | REVERSED
  feeBasis            String                   @default("OUTPUT") // INPUT | OUTPUT | FACTORY_WEIGHT | FIXED
  chargedWeight       Decimal
  feePerKg            Decimal
  feeTotal            Decimal
  costAllocationBasis String                   @default("OUTPUT_WEIGHT")
  outboundFreight     Decimal                  @default(0)
  returnFreight       Decimal                  @default(0)
  otherCost           Decimal                  @default(0)
  inputWeight         Decimal
  outputWeight        Decimal
  weightDiff          Decimal
  handlerName         String
  note                String?
  createdAt           DateTime                 @default(now())
  inputs              ProcessingInput[]
  outputs             ProcessingOutput[]
  feeSettlement       ProcessingFeeSettlement?

  @@index([factoryId, date])
}

model ProcessingInput {
  id          String        @id @default(cuid())
  jobId       String
  job         ProcessingJob @relation(fields: [jobId], references: [id])
  lotId       String
  lot         InventoryLot  @relation(fields: [lotId], references: [id])
  inventoryId String
  inventory   Inventory     @relation(fields: [inventoryId], references: [id])
  weight      Decimal
  packages    Int?
  goodsCost   Decimal
  freightCost Decimal

  @@index([jobId])
  @@index([lotId])
}

model ProcessingOutput {
  id                 String        @id @default(cuid())
  jobId              String
  job                ProcessingJob @relation(fields: [jobId], references: [id])
  lotId              String        @unique
  lot                InventoryLot  @relation("ProcessingOutputLot", fields: [lotId], references: [id])
  weight             Decimal
  packages           Int?
  allocatedGoodsCost Decimal
  allocatedFreight   Decimal

  allocationWeight        Decimal @default(0)
  allocatedProcessingCost Decimal @default(0)
  allocatedOtherCost      Decimal @default(0)

  @@index([jobId])
}
