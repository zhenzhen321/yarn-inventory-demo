# 部署展示模板：复制为 .env.production 后替换所有示例值
DOMAIN=demo.example.com
DATABASE_URL=file:/data/prod.db
SESSION_SECRET=replace-with-a-random-secret-at-least-48-characters
COOKIE_SECURE=true
ADMIN1_PASSWORD=replace-with-a-strong-admin-password
ADMIN2_PASSWORD=replace-with-a-strong-clerk-password

# 仅在数据库文件首次创建时写入演示数据；重启不会重复执行
SEED_DEMO_DATA=true
